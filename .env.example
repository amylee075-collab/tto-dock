# ===== .env.local 에 넣을 때 이 파일을 복사해서 .env.local 로 저장한 뒤 값만 채우세요 =====
# 자세한 설명: docs/ENV_LOCAL_GUIDE.md

# Supabase (필수) — 어드민과 또독 앱이 동일한 DB를 보려면 같은 URL·anon 키 사용
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NextAuth (이메일·구글 로그인)
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# 구글 로그인 (Google Cloud Console OAuth 2.0 클라이언트)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase 서비스 역할 (약관·학습 데이터 저장용, 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# On-Demand Revalidation (선택) — Admin 저장 후 캐시 무효화 API 호출 시 Authorization: Bearer 값
# REVALIDATE_SECRET=your-secret
